# Servidor
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Projetos com JWT simétrico (legado). Se vazio, a verificação usa o JWKS do projeto.
SUPABASE_JWT_SECRET=

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# --- Worker de operação (npm run worker) ---------------------------------
# Polling do iFood. 30s é o intervalo recomendado pelo próprio iFood.
MARKETPLACE_POLL_SECONDS=30
# Consumo da fila de emissão fiscal.
FISCAL_POLL_SECONDS=60
